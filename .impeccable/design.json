  "narrative": {
    "northStar": "The Stage Console",
    "overview": "A dim, utilitarian backstage control surface. It stays quiet until something is live, then the state color speaks. Everything is flat charcoal with hairline dividers; the interface should never compete with the show for attention, and it must be readable at arm's length in a dark room.",
    "keyCharacteristics": [
      "Dark-only (color-scheme: dark); no light theme.",
      "Flat, tonal depth with 1px hairlines; no shadows.",
      "One cool accent (blue) for selection; green, red and amber reserved for state.",
      "Large touch targets (44px minimum, 48px for the ▶ cue button).",
      "System font stack, tabular numerals for time."
    ],
    "rules": [
      {
        "name": "The State-Only Color Rule",
        "body": "Green, red and amber appear only to report transport or connection state. They are never used for decoration or branding.",
        "section": "colors"
      },
      {
        "name": "The Lone Accent Rule",
        "body": "Cue Blue marks selection (the active tab). It is not a button fill or a link color.",
        "section": "colors"
      },
      {
        "name": "The Dark Room Rule",
        "body": "Text stays at #e8e8e8 on #16181b (not pure white on black) to limit glare; dimmer secondary text uses opacity (0.6), not a new grey.",
        "section": "colors"
      },
      {
        "name": "The Tabular Time Rule",
        "body": "Any time value uses tabular numerals so digits do not jitter while the clock runs.",
        "section": "typography"
      },
      {
        "name": "The Flat-Always Rule",
        "body": "No box-shadows, no blur. If a control must stand out, change its tone or border, not its elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep every touch target at least 44px, and the ▶ cue button 48px.",
      "Do reserve green, red and amber for state, and Cue Blue for selection.",
      "Do convey depth with tone and hairlines.",
      "Do use tabular numerals for all time values.",
      "Do keep text at #e8e8e8 on #16181b or darker surfaces; verify at least 4.5:1 contrast for any new text color."
    ],
    "donts": [
      "Don't make list rows tappable; only the ▶ button acts.",
      "Don't add shadows, glows, gradients or glossy skeuomorphic controls.",
      "Don't add a light theme or bright white surfaces; they glare on a dark stage.",
      "Don't use color alone to convey state; keep the state word beside it.",
      "Don't use new accent hues for decoration."
    ]
  }

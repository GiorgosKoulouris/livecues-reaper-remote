      "css": ".ds-list{list-style:none;margin:0;padding:0;color:#e8e8e8;font:16px/1.4 system-ui,sans-serif}.ds-row{display:flex;align-items:center;gap:.75rem;padding:.375rem .25rem;border-bottom:1px solid #2b2f34}.ds-active{background:#1f3a52}.ds-cue{width:48px;height:48px;border:1px solid #2b2f34;border-radius:6px;background:#2a2e33;color:inherit}.ds-swatch{width:1rem;height:1rem;border-radius:50%;border:1px solid #2b2f34}.ds-name{flex:1;font-size:1.1rem}.ds-start{font-variant-numeric:tabular-nums;opacity:.6;font-size:.85rem}"
